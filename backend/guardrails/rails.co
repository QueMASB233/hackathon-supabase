define user ask jailbreak
  "ignore previous instructions"
  "ignora las instrucciones"
  "jailbreak"
  "system prompt"
  "revela todos los clientes"

define user ask other tenant
  "qué documentos tiene maría"
  "workspace de maría"
  "otro cliente"
  "otros workspaces"

define bot refuse jailbreak
  "Esta solicitud no puede procesarse dentro de este workspace."

define bot refuse scope
  "Esta solicitud está fuera del alcance de este workspace."

define flow jailbreak check
  user ask jailbreak
  bot refuse jailbreak

define flow workspace scope check
  user ask other tenant
  bot refuse scope
